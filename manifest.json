{
  "manifest_version": 3,
  "name": "Commander Cart Tagger",
  "version": "0.2.0",
  "description": "Tag your TCG cart items to the Commander deck they are for. Local-only; never checks out for you.",
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://api.scryfall.com/*",
    "https://manapool.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Commander Cart Tagger"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://manapool.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://manapool.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "key": ""
}
